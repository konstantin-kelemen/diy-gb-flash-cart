* text=auto

*.md text eol=lf
*.csv text eol=lf
*.v text eol=lf
*.lpf text eol=lf
*.ldf text eol=lf
*.sty text eol=lf
*.kicad_pro text eol=lf
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf

# Артефакты Diamond сохраняются побайтово: их SHA-256 опубликованы в манифесте.
*.jed binary
*.twr -text
*.mrp -text
*.bgn -text

*.pdf binary
*.png binary
*.webp binary
*.zip binary
*.stl binary
*.step binary
*.stp binary
*.3mf binary

# Выпуски, включая снимки исходников и манифесты, сохраняются побайтово.
# Это правило должно идти после правил расширений: SHA-256 зависит от CRLF/LF.
/releases/** -text !eol
